# Supabase project (Dashboard → Project Settings → API)
# Only these two are needed — the app has NO service_role key.
# All database access runs as the logged-in user and is guarded by
# RLS policies (scripts/rls-setup.sql — run it once in the SQL Editor).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<your-anon-or-publishable-key>

# Real email delivery via your Hostinger mailbox (free with your domain).
# hPanel → Emails → Manage → connect a device → use those credentials.
# Example: SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465
#          SMTP_USER=bookings@reventos.feroferto.com  SMTP_PASSWORD=<mailbox-password>
#
# All booking emails (customer confirmation, owner "new booking" alert, and
# appointment reminders) are sent FROM this mailbox. The password key accepts
# either SMTP_PASSWORD or SMTP_PASS; SMTP_FROM overrides the display sender
# (defaults to "RantevouOS Bookings <SMTP_USER>").
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Shared secret for the automatic reminder-email worker (Nitro scheduled task
# runs every 5 minutes; no external cron needed). Also used to trigger the
# worker manually: curl -X POST https://<host>/api/cron/notifications
#   -H "x-cron-secret: <CRON_SECRET>"
CRON_SECRET=

# Demo seed (npm run db:seed): UUIDs of the two users created in
# Supabase Auth → Users, with emails m.shahbazasif512@gmail.com (admin)
# and riders@feroferto.gr (business owner).
SUPABASE_ADMIN_USER_ID=
SUPABASE_BUSINESS_USER_ID=
