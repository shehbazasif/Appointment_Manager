# Supabase project (Dashboard → Project Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<anon public key>

# Tenant database for Drizzle/Nitro (Dashboard → Project Settings → Database).
# Use the Session pooler URI, e.g.:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Demo seed (npm run db:seed): UUIDs of the two users created in
# Supabase Auth → Users, with emails m.shahbazasif512@gmail.com (admin)
# and riders@feroferto.gr (business owner).
SUPABASE_ADMIN_USER_ID=
SUPABASE_BUSINESS_USER_ID=
